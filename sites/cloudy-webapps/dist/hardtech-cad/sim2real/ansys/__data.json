{"type":"data","nodes":[null,{"type":"data","data":[{"view":1,"shell":24},{"kind":2,"app":3,"sections":8,"section":19,"sectionLabel":20,"page":23,"sub":24,"tabs":25,"tabSelected":23,"subtabs":40,"subSelected":24,"title":41,"path":42,"portal":43,"listDetail":43,"background":44,"crumbs":45,"related":50,"aiHref":24,"profileHref":56,"configsHref":24,"portalInfo":24,"mode":57,"groups":58,"sideItems":64,"navUi":24,"wasmHref":24,"portalHref":24,"data":65},"app",{"id":4,"name":5,"label":6,"icon":7,"kind":2},"hardtech-cad","Hardtech-CAD","CAD","ic_p_sol_pro",[9,14,18],{"id":10,"label":11,"icon":12,"href":13},"models","Models","layers","/cloud-webapps/hardtech-cad/models/",{"id":15,"label":16,"icon":15,"href":17},"home","Home","/cloud-webapps/hardtech-cad/home/",{"id":19,"label":20,"icon":21,"href":22},"sim2real","Sim2Real","insights","/cloud-webapps/hardtech-cad/sim2real/","ansys",null,[26,31,36],{"id":27,"label":28,"icon":29,"href":30},"sap2000","SAP2000","assessment","/cloud-webapps/hardtech-cad/sim2real/sap2000/",{"id":32,"label":33,"icon":34,"href":35},"matlab","MATLAB","table_chart","/cloud-webapps/hardtech-cad/sim2real/matlab/",{"id":23,"label":37,"icon":38,"href":39},"Ansys","speed","/cloud-webapps/hardtech-cad/sim2real/ansys/",[],"Ansys · Sim2Real · CAD","hardtech-cad/sim2real/ansys//",false,"dark",[46,48,49],{"label":5,"href":47},"/cloud-webapps/hardtech-cad/",{"label":20,"href":22},{"label":37,"href":39},[51,53,54],{"id":27,"label":28,"href":30,"indent":52,"selected":43},0,{"id":32,"label":33,"href":35,"indent":52,"selected":43},{"id":23,"label":37,"href":39,"indent":52,"selected":55},true,"/cloud-webapps/cloud-account/","horizontal_one_row",[59],{"id":19,"label":20,"pages":60},[61,62,63],{"id":27,"label":28,"icon":29,"href":30,"separatorBefore":43},{"id":32,"label":33,"icon":34,"href":35,"separatorBefore":43},{"id":23,"label":37,"icon":38,"href":39,"separatorBefore":43},[],{"stack":66},[67,71,75,79,83,87,91],{"title":37,"subtitle":68,"rows":69,"caption":70,"href":24,"planned":55,"external":43},"Finite element and fluid simulation",[],"Planned: coming. No connector is shipped yet; this page describes the intended integration.",{"title":72,"subtitle":73,"rows":74,"caption":73,"href":24},"Planned integration","",[],{"title":76,"subtitle":77,"rows":78,"caption":73,"href":24},"Role in Sim2Real","Runs finite element and flow simulations on a model brought from Models (a STEP solid) and returns stress, temperature or velocity fields for the 3D viewer, closing the loop between a design and its measured behaviour.",[],{"title":80,"subtitle":81,"rows":82,"caption":73,"href":24},"How the tool is reached","Ansys products are scripted through the open PyAnsys Python packages, which talk to the solver over gRPC on a licensed host; a fleet agent would start the session, run the study and hand back the result files. No licence or solver is bundled in the app and none is needed on the phone.",[],{"title":84,"subtitle":85,"rows":86,"caption":73,"href":24},"Inputs and outputs","In: STEP geometry, material and boundary-condition tables as JSON. Out: field results as VTK or GLB, and summary tables as CSV.",[],{"title":88,"subtitle":89,"rows":90,"caption":73,"href":24},"Open-source alternative","CalculiX and Elmer (finite element) and OpenFOAM (fluid flow) are open-source solvers that would be the first targets while the commercial connector is built.",[],{"title":92,"subtitle":93,"rows":94,"caption":73,"href":24},"Status","Planned. The HardTech-Stack-CAD-Simulators repository holds no connector for this tool yet; the page will switch to a live connection when one ships.",[]],"uses":{"params":["path"]}}]}
